CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=102400
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Penyangga Wi-Fi untuk jaringan padat.
#
# Nilai lama di sini adalah 3, 6, dan 3, yaitu jauh di bawah bawaan ESP-IDF.
# Setelan sehemat itu berasal dari papan bermemori kecil dan tidak cocok untuk
# ESP32-S3 yang punya PSRAM delapan megabyte. Pada Wi-Fi kampus yang padat,
# penyangga setipis itu membuat paket audio hilang berbondong-bondong: log
# perangkat pernah menunjukkan sembilan puluh lima paket berturut-turut lenyap
# sekaligus, yaitu lebih dari lima detik suara.
#
# Berkas ini menimpa sdkconfig.defaults, jadi nilainya harus diperbaiki di sini
# juga, bukan hanya di berkas induk.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=10
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

# Use an internal DMA bounce buffer so incomplete RGB frames can be rejected.
# Limit its size to preserve internal heap for AFE and WakeNet.
CONFIG_CAMERA_PSRAM_DMA=n
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=16384

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y

# ---------------------------------------------------------------------------
# Mr Great: model pengenalan perintah untuk kata pemicu "hai hai"
#
# CONFIG_USE_CUSTOM_WAKE_WORD memerlukan model MultiNet. Model Mandarin
# MultiNet6 dipakai karena mendukung masukan pinyin, dan "hai hai" ditulis
# memakai ejaan pinyin sehingga cocok dengan model ini.
# ---------------------------------------------------------------------------
CONFIG_SR_MN_CN_MULTINET6_QUANT=y
CONFIG_SR_MN_EN_NONE=y

# Builtin TLSF pool in PSRAM (lvgl_psram_pool.h). Keep the base pool small
# enough for 2MB PSRAM boards; 8MB boards add extra pools in lcd_display.cc
# (chunked to LV_MEM_SIZE — TLSF rejects a single add_pool larger than this).
# Variants that set CONFIG_SPIRAM=n are switched back to CLIB malloc in
# scripts/build.py; do not repeat that override on each board.
CONFIG_LV_USE_BUILTIN_MALLOC=y
# CONFIG_LV_USE_CLIB_MALLOC is not set
CONFIG_LV_MEM_SIZE_KILOBYTES=1024
