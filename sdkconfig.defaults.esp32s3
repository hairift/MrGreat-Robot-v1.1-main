CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Penyangga Wi-Fi untuk jaringan padat.
#
# Nilai lama di sini adalah 3, 6, dan 3, yaitu jauh di bawah bawaan ESP-IDF.
# Setelan sehemat itu berasal dari papan bermemori kecil dan tidak cocok untuk
# ESP32-S3 yang punya PSRAM delapan megabyte. Pada Wi-Fi kampus yang padat,
# penyangga setipis itu membuat paket audio hilang berbondong-bondong: log
# perangkat pernah menunjukkan sembilan puluh lima paket berturut-turut lenyap
# sekaligus, yaitu lebih dari lima detik suara.
#
# Berkas ini menimpa sdkconfig.defaults, jadi nilainya harus diperbaiki di sini
# juga, bukan hanya di berkas induk.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=10
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y

# ---------------------------------------------------------------------------
# Riri Boneka: model pengenalan perintah untuk kata pemicu "hai hai"
#
# CONFIG_USE_CUSTOM_WAKE_WORD memerlukan model MultiNet. Model Mandarin
# MultiNet6 dipakai karena mendukung masukan pinyin, dan "hai hai" ditulis
# memakai ejaan pinyin sehingga cocok dengan model ini.
# ---------------------------------------------------------------------------
CONFIG_SR_MN_CN_MULTINET6_QUANT=y
CONFIG_SR_MN_EN_NONE=y
