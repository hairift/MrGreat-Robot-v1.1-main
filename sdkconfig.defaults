CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=2048

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y

# Penyangga Wi-Fi untuk jaringan padat.
#
# Nilai bawaan proyek ini disalin dari papan ESP32-C3 yang memorinya jauh lebih
# kecil, lalu ikut terpakai di ESP32-S3 yang punya PSRAM delapan megabyte.
# Akibatnya penyangga penerimaan sangat tipis, dan pada jaringan padat seperti
# Wi-Fi kampus paket audio hilang berbondong-bondong. Log perangkat pernah
# menunjukkan sembilan puluh lima paket berturut-turut lenyap sekaligus, yaitu
# lebih dari lima detik suara yang hilang begitu saja.
#
# Nilai di bawah ini masih jauh di bawah bawaan ESP-IDF untuk papan besar,
# tetapi sudah memberi ruang tampung yang cukup untuk menahan lonjakan.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# Jendela block-ack menentukan berapa banyak paket boleh datang tidak berurutan
# sebelum dianggap hilang. Tiga terlalu sempit untuk jaringan yang sibuk.
CONFIG_ESP_WIFI_RX_BA_WIN=10

# Penyangga Wi-Fi dan LWIP diarahkan ke PSRAM sehingga RAM internal tetap lega
# meski jumlah penyangganya dinaikkan.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# Fix ML307 FIFO Overflow
CONFIG_UART_ISR_IN_IRAM=y

# Fix ESP_SSL error
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n

# LVGL 9.2.2

CONFIG_LV_OS_NONE=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_IMGFONT=y
CONFIG_LV_USE_ASSERT_STYLE=y

# Use compressed font
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_COMPRESSED=n
CONFIG_LV_USE_FONT_PLACEHOLDER=n
CONFIG_LV_USE_LODEPNG=y

# Disable extra widgets to save flash size
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CALENDAR_HEADER_ARROW=n
CONFIG_LV_USE_CALENDAR_HEADER_DROPDOWN=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n

CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

# ---------------------------------------------------------------------------
# Mr Great
# ---------------------------------------------------------------------------
# Papan dan bahasa
CONFIG_BOARD_TYPE_BREAD_COMPACT_WIFI=y
CONFIG_LANGUAGE_ID_ID=y
CONFIG_OLED_SSD1306_128X64=y

# Kata pemicu lokal "hai hai"
CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_CUSTOM_WAKE_WORD="hai hai"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="Hai Hai"
# Kata pemicu kedua khusus Mr Great Robot. Ditulis dalam pinyin karena model
# multinet yang dipakai berbahasa Mandarin.
CONFIG_CUSTOM_WAKE_WORD_EXTRA="hei ge rui te bo si"
CONFIG_CUSTOM_WAKE_WORD_EXTRA_DISPLAY="Hey Great Bos"
CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=8
CONFIG_SEND_WAKE_WORD_DATA=y

# Nada tunggu ikut di-flash ke partisi aset
CONFIG_FLASH_DEFAULT_ASSETS=y

# Layanan daring Mr Great. Isi alamat server setelah diterapkan ke Cloud Run.
CONFIG_MRGREAT_SERVER_URL="https://mrgreat-server-1023596067013.asia-southeast2.run.app"
CONFIG_MRGREAT_SERVER_SECRET="mrgreat-robot-2026"
CONFIG_CAMPUS_RAG_ENABLE=y
CONFIG_CAMPUS_RAG_TIMEOUT_MS=2500
CONFIG_MRGREAT_WEB_SEARCH_SERVER=y
CONFIG_MUSIC_PLAYER_ENABLE=y

# Bahasa firmware dibatasi Indonesia dan Inggris agar partisi aset tetap ringan.
CONFIG_LANGUAGE_EN_US=n
