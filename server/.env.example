# Salin menjadi .env lalu isi nilainya. Berkas .env tidak ikut diunggah ke Git.

# Harus sama dengan CONFIG_RIRI_SERVER_SECRET di firmware.
RIRI_SECRET_KEY=riri-boneka-2026

# Kunci YouTube Data API v3.
# Nilai bawaan sudah tertanam di config.py, tetapi nilai di sini akan
# mengalahkannya. Isi bila kunci lama sudah habis kuotanya.
YOUTUBE_API_KEY=
YOUTUBE_REGION=ID

# Kosongkan untuk memakai singgahan di memori proses.
REDIS_URL=

# Singgahan hasil pencarian web, dalam detik.
CACHE_TTL_SEARCH=600

# Batas ukuran singgahan lagu dalam megabita.
# Penting untuk Cloud Run karena sistem berkasnya berada di memori.
MUSIC_CACHE_MAX_MB=120

# Matikan hanya saat menguji dari peramban.
REQUIRE_AUTH=true
